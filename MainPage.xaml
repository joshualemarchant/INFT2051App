<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="INFT2051App.MainPage"
             Title="">
			 
  <ScrollView>
        <VerticalStackLayout>
            
            <!-- Title -->
            <Label Text="Your Questions" 
                   FontSize="28" 
                   HorizontalOptions="Start"
                   Margin="0,0,0,20"/>

            <Border>
                <SearchBar x:Name="FilterSearchBar"
                       Placeholder="Search Questions..."
                       TextChanged="OnTextChanged">
                </SearchBar>
            </Border>
            
            <!--Display message if user has no questions-->
            <Label x:Name="NoQuestionsLabel"
                   Text="No questions yet!"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Margin="0, 200, 0, 0"
                   IsVisible="False"/>  

            <!-- Question list -->
            <CollectionView x:Name="QuestionsCollection"
                            ItemsLayout="VerticalList"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                        <DataTemplate>
                        <Border>
                            <VerticalStackLayout Style="{StaticResource DisplayBox}">
                                <!--Question-->
                                    <Label Text="{Binding Prompt}"
                                           Style="{StaticResource SubHeadline}"
                                           LineBreakMode="WordWrap"
                                           HorizontalOptions="Start"
                                           HorizontalTextAlignment="Start"/>

                                <StackLayout Padding="0,20,0,20"
                                             Orientation="Horizontal"
                                             HorizontalOptions="Start">

                                    <!--Answer-->
                                    <Label Text="{Binding Answer}"/>


                                </StackLayout>

                                <StackLayout Orientation="Horizontal"
                                             HorizontalOptions="End">
                                    
                                    <!--Uncomment for quick deletion while testing-->
                                    <Button
                                        Text="Delete"
                                        Clicked="OnDeleteAnswerClicked"
                                        Style="{StaticResource StyledButton}"/>
                                </StackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                                 
        </VerticalStackLayout>
    </ScrollView>
 
</ContentPage>
