<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="INFT2051App.Pages.AnswerQuestionPage"
             Title="">
    
    
    <ScrollView>
        <VerticalStackLayout>
            
            <!--Question-->
            <Label Text="{Binding Question.Prompt}"
                   TextColor="White" 
                   Style="{StaticResource Headline}"
                   Padding="0, 30, 0, 100"/>

            <!--User Answer-->
            <Editor x:Name="AnswerEditor"
                    Placeholder="Type your answer here..."
                    AutoSize="TextChanges"
                    HeightRequest="80"
                    FontSize="14"
                    Text="{Binding UserAnswer, Mode=TwoWay}"
                    TextChanged="UpdateEntryButtonColour"/>
            
            <!--Submit Question Button-->
            <Button x:Name="EnterButton" 
                    Text="Enter" 
                    Clicked="OnEnterClicked" 
                    Style="{StaticResource GreyButton}"
                    />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>