<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="INFT2051App.Pages.EditQuestionPage"
             Title="">
    
        <ScrollView>
        <VerticalStackLayout>
            
            <!--Edit Question fields-->
            <Entry x:Name="NewQuestion"></Entry>
            <Entry x:Name="NewAnswer"></Entry>

            <HorizontalStackLayout 
                Spacing="30"                                   
                HorizontalOptions="Center"
                Padding="0,100,0,0">
                
                <!--Delete Button-->
                <Button
                        Text="Delete"
                        Clicked="OnDeleteAnswerClicked"
                        Background="#fc7070"
                        TextColor="White"
                        Style="{StaticResource StyledButton}"
                        WidthRequest="120"/>
                
                <!--Save button-->
                <Button Text="Save"
                        Style="{StaticResource StyledButton}"
                        Clicked="OnSaveClicked"
                        WidthRequest="120"/>
            </HorizontalStackLayout>    
        </VerticalStackLayout>
        </ScrollView>
    
</ContentPage>