<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="INFT2051App.SettingsPage"
             Title="">
    <VerticalStackLayout>
        <Label 
            Text="Settings"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Label
            Text="Prompting Hours:">
            
        </Label>
        
        <TimePicker x:Name="UserStartTime"
            Time="{Binding PromptHourStart, Mode=TwoWay}" />

        <TimePicker x:Name="UserEndTime"
            Time="{Binding PromptHourEnd, Mode=TwoWay}" />

        <Button
            Text="Save Times"
            Clicked="OnSaveClicked"
            Style="{StaticResource StyledButton}"/>
    </VerticalStackLayout>
</ContentPage>