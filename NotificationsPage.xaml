<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="INFT2051App.NotificationsPage"
             Title="">

    <ScrollView>
        <VerticalStackLayout>
            <CollectionView x:Name="DueQuestionsCollection"
                            ItemsSource="{Binding DueQuestions}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                    <Border>
                        <VerticalStackLayout Spacing="5">

                            <!-- Question text -->
                            <Label Text="{Binding Text}" 
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"/>

                            <!-- Created/Submitted date -->
                            <Label Text="{Binding CreatedAt, StringFormat='Created: {0:MMM dd, yyyy hh:mm tt}'}"
                                   FontSize="12"
                                   TextColor="Gray"/>

                            <!-- Due indicator -->
                            <Label Text="⚠️ This question is due!"
                                   TextColor="Red"
                                   FontAttributes="Bold"
                                   FontSize="14"/>

                            <!-- Optional action button -->
                            <Button Text="View" 
                                    Command="{Binding Source={x:Reference NotificationsPage}, Path=BindingContext.ViewQuestionCommand}" 
                                    CommandParameter="{Binding .}" 
                                    BackgroundColor="#6200EE" 
                                    TextColor="White"
                                    CornerRadius="8"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>