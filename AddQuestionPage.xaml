<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="INFT2051App.AddQuestionPage"
             Title="">
    <VerticalStackLayout>
        <Label Text="Question:" />
        <Entry x:Name="PromptEntry" Placeholder="Enter your question" />

        <Label Text="Answer: " />
        <Editor x:Name="AnswerEditor" Placeholder="Enter answer" HeightRequest="100" />

        <Button Text="Save" Clicked="onSaveClicked" />
    </VerticalStackLayout>
</ContentPage>