<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="INFT2051App.AddQuestionPage"
             Title="">

    
    <ContentView>
        <VerticalStackLayout Spacing="20" Padding="15">

            <!-- Question Section -->
            <Border>
                <VerticalStackLayout Spacing="10" Style="{StaticResource DisplayBox}">
                    <Label Text="Question:" />
                    <Entry x:Name="PromptEntry" Placeholder="Enter your question"/>
                </VerticalStackLayout>
            </Border>

            <!-- Answer Section -->
            <Border>
                <VerticalStackLayout Spacing="10" Style="{StaticResource DisplayBox}">
                    <Label Text="Answer:" />
                    <Editor x:Name="AnswerEditor" Placeholder="Enter answer"/>
                </VerticalStackLayout>
            </Border>

            <!-- Test Mode Option -->
            <Label x:Name="TestOptionLabel"
                   Text="Test Mode"
                   FontSize="18"
                   HorizontalOptions="Center" 
                   Padding="0,30,0,0"/>

            <HorizontalStackLayout Spacing="10" VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="Off"
                       x:Name="OffOnLabel"
                       VerticalOptions="Center"
                       HorizontalOptions="Center" />
                <Switch x:Name="ToggleSwitch"
                        IsToggled="False"
                        Toggled="TestSwitchToggled"
                        HorizontalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Date Selection -->                     
            <StackLayout x:Name="DateSelectionBox" IsVisible="True" Padding="20">
                <Label Text="Select Time:" />
                <DatePicker x:Name="MyDatePicker"                   
                            MinimumDate="{Binding CurrentDateTime}"
                            MaximumDate="12/31/2100"
                            Format="D"/>
            </StackLayout>
        
            <!-- Save Button -->
            <Button Text="Save" Clicked="onSaveClicked" Style="{StaticResource StyledButton}"/>

        </VerticalStackLayout>
    </ContentView>

</ContentPage>
